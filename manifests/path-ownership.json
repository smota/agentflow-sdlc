{
  "version": 1,
  "knownSeats": [
    "pm.manager",
    "pm.analyst",
    "pm.lead",
    "dev.build",
    "dev.build-jr",
    "dev.build-sr",
    "dev.test-eng",
    "dev.qa",
    "arch.lead",
    "rev.gate",
    "rev.review",
    "orch.lead",
    "steer.lead",
    "orch.arch",
    "eval.tester",
    "steer.po"
  ],
  "rules": [
    {
      "id": "governance-files-guard",
      "seats": [
        "pm.manager",
        "pm.analyst",
        "pm.lead",
        "dev.build",
        "dev.build-jr",
        "dev.build-sr",
        "dev.test-eng",
        "dev.qa",
        "arch.lead",
        "rev.gate",
        "rev.review",
        "orch.lead",
        "steer.lead",
        "orch.arch",
        "eval.tester",
        "steer.po"
      ],
      "deny": ["manifests/path-ownership.json", "scripts/validate-path-ownership.mjs"]
    },
    {
      "id": "pm-write-guard",
      "seats": ["pm.manager", "pm.analyst", "pm.lead"],
      "seatPrefixes": ["pm."],
      "allow": [".agentflow/**", "goals/**"],
      "defaultDeny": true
    },
    {
      "id": "steer-write-guard",
      "seats": ["steer.lead", "steer.po"],
      "seatPrefixes": ["steer."],
      "allow": [],
      "defaultDeny": true
    },
    {
      "id": "builder-oracle-guard",
      "seats": ["dev.build", "dev.build-jr", "dev.build-sr"],
      "deny": ["tests/oracles/**", "tests/**/oracles/**"]
    },
    {
      "id": "test-eng-source-guard",
      "seats": ["dev.test-eng"],
      "allow": ["tests/**", "lib/__tests__/**", "scripts/__tests__/**", "guidance/**"],
      "deny": ["src/**"],
      "defaultDeny": true
    },
    {
      "id": "arch-write-scope",
      "seats": ["orch.arch", "arch.lead", "orch.lead"],
      "deny": []
    },
    {
      "id": "review-oracle-guard",
      "seats": ["dev.qa", "rev.review", "rev.gate"],
      "deny": ["tests/oracles/**", "tests/**/oracles/**"]
    },
    {
      "id": "eval-write-guard",
      "seats": ["eval.tester"],
      "allow": [".agentflow/intake/**"],
      "defaultDeny": true
    }
  ]
}
