{
  "id": "agentflow-sdlc.openrig",
  "name": "AgentFlow SDLC for OpenRig",
  "version": "1.0.0",
  "harness": "openrig",
  "namespace": "agentflow",
  "entry": "agentflow",
  "rigs": ["agentflow"],
  "skills": [
    "agentflow-orchestrator",
    "agentflow-collaborator",
    "agentflow-scanner",
    "agentflow-designer",
    "agentflow-migrator",
    "agentflow-auditor"
  ],
  "roles": ["architect", "developer", "developer-jr", "tester", "reviewer"],
  "commands": [
    "agentflow-sdlc adapters install openrig [--preset <name>] [repo]",
    "agentflow-sdlc adapters update openrig",
    "agentflow-sdlc adapters squads provision openrig [--kind delivery|product] [--sibling <rig>] <project> [path]",
    "agentflow-sdlc adapters squads update openrig <project>",
    "agentflow-sdlc adapters squads list openrig [--json]",
    "agentflow-sdlc adapters squads remove openrig <project>",
    "rig up agentflow --cwd <project>",
    "rig down agentflow --snapshot",
    "rig up agentflow --existing",
    "rig ps --nodes --rig agentflow",
    "rig up agentflow-<project> --cwd <path>"
  ],
  "lifecycle": {
    "module": "lifecycle.mjs"
  }
}
