{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/audit-result.schema.json",
  "title": "AgentFlow SDLC audit result",
  "type": "object",
  "required": ["ok", "findings"],
  "properties": {
    "ok": { "type": "boolean" },
    "profile": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["blocker", "high", "medium", "low", "info"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "source": { "type": "string" },
          "recommendation": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
