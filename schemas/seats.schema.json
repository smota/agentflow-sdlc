{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/seats.schema.json",
  "title": "AgentFlow Canonical Seat Table",
  "type": "object",
  "required": ["version", "seats", "aliases"],
  "properties": {
    "version": { "const": 1 },
    "seats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "pod", "member", "roles", "phases", "plane", "writes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*$" },
          "pod": { "type": "string", "pattern": "^[a-z]+$" },
          "member": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "phases": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 8 } },
          "plane": { "enum": ["product", "delivery", "eval", "steer"] },
          "writes": {
            "type": "object",
            "required": ["rule"],
            "properties": {
              "rule": { "type": "string", "minLength": 1 },
              "allow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "deny": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "defaultDeny": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "canonical", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*$" },
          "canonical": { "type": "string", "pattern": "^[a-z]+\\.[a-z][a-z0-9-]*$" },
          "status": { "enum": ["legacy"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
