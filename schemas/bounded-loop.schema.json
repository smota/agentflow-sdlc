{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentFlow Bounded Loop Evidence",
  "type": "object",
  "required": ["loopType", "maxIterations", "stopConditions", "exitReason"],
  "properties": {
    "loopType": { "enum": ["test-fix", "review-fix", "manifest-fix", "format-fix"] },
    "maxIterations": { "type": "integer", "minimum": 1 },
    "iterationsRun": { "type": "integer", "minimum": 0 },
    "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exitReason": { "type": "string", "minLength": 1 },
    "remainingFindings": { "type": "array", "items": { "type": "string" } }
  }
}
