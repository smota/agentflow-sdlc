{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schemas/engineering-request.schema.json",
  "title": "Neutral engineering request v1",
  "type": "object",
  "required": [
    "version",
    "operationId",
    "candidateDigest",
    "executionTarget",
    "permissionBoundary",
    "timeoutMs",
    "requiredCapabilities"
  ],
  "properties": {
    "version": { "const": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "candidateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionTarget": { "type": "string", "minLength": 1 },
    "requestedModel": { "type": ["string", "null"] },
    "permissionBoundary": {
      "enum": ["observe", "propose", "mutate-worktree", "open-pr", "external-action"]
    },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "requiredCapabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "expectedArtifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
