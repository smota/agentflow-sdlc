{
  "ciCommands": ["pnpm test", "pnpm test:workflow", "pnpm format:check"],
  "bounded": {
    "allowedExactPaths": ["README.md", "AGENTS.md", "CLAUDE.md", "CODEX.md", "AGY.md"],
    "allowedPathPrefixes": ["docs/", "agents/templates/", "agents/workflows/"],
    "deniedPathFragments": ["/auth/", "/billing/", "/migrations/"],
    "defaultBase": "origin/development"
  },
  "branching": {
    "trunk": "main",
    "releaseCandidate": null,
    "integration": "development",
    "directEditDeniedBranches": ["main", "development"],
    "defaultPrTarget": "development",
    "promotionOrder": ["development", "main"],
    "workBranchPrefixes": ["work/", "feature/", "fix/", "hotfix/", "spike/", "chore/"],
    "compatibilityBranchPrefixes": ["issue/", "wt/", "claude/"],
    "requireBoundedWorkBranch": true
  },
  "integrationLifecycle": {
    "integrationBranch": "development",
    "trunkBranch": "main",
    "referenceKeywords": ["Implements", "Closes"],
    "addLabels": ["integrated:development", "awaiting-release"],
    "closeIntegratedIssues": true
  },
  "routing": {
    "defaultMode": "optional-multi-agent",
    "agents": {
      "grok": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "grok",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "grok-cli",
        "callWorkflowDoc": "docs/agents/grok-routing.md"
      },
      "claude": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "claude",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "claude-cli",
        "callWorkflowDoc": "docs/agents/claude-routing.md"
      },
      "codex": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "codex",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "codex-cli",
        "callWorkflowDoc": "docs/agents/codex-routing.md"
      },
      "agy": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "agy",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "agy-cli",
        "callWorkflowDoc": "docs/agents/agy-routing.md"
      }
    },
    "roles": {
      "product-manager": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "analyst": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "architect": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "implementation-planner": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "developer": {
        "owner": "claude",
        "fallbacks": ["grok", "codex"]
      },
      "tester": {
        "owner": "codex",
        "fallbacks": ["claude", "grok"]
      },
      "reviewer": {
        "owner": "grok",
        "fallbacks": ["codex", "claude"]
      },
      "technical-writer": {
        "owner": "claude",
        "fallbacks": ["grok", "codex"]
      },
      "pr-readiness": {
        "owner": "grok",
        "fallbacks": ["codex", "claude"]
      }
    }
  },
  "collaboration": {
    "defaultMode": "auto-minimal",
    "sensitiveSurfaces": ["security", "auth", "data", "infra", "billing"],
    "councilDomainThreshold": 3,
    "bilateralDomainThreshold": 2,
    "councilOnPublicContract": true,
    "councilOnMigration": true,
    "maxReworkRounds": 2,
    "councilHelpers": [
      "risk-scout",
      "implementation-strategist",
      "testability-scout",
      "docs-impact-scout"
    ],
    "discoveryHelpers": ["requirements-scout", "architecture-scout"],
    "councilSeats": [
      {
        "role": "agentflow:architect",
        "focus": "architecture and system boundaries",
        "required": true
      },
      {
        "role": "agentflow:developer",
        "focus": "implementation feasibility",
        "required": true
      },
      {
        "role": "agentflow:tester",
        "focus": "testability and failure evidence",
        "required": true
      },
      {
        "role": "agentflow:reviewer",
        "focus": "risk and maintainability",
        "required": true
      }
    ],
    "fallbackModes": ["sequential", "manual"],
    "maxDelegates": 4,
    "maxDepth": 1,
    "maxIterations": 3
  },
  "executionTopology": {
    "substrateTier": "auto",
    "openrigSquadPreset": "lean-4-seat",
    "compositeBuilderMaxRung": "P1"
  },
  "effortPolicy": {
    "defaultLoopEffort": "medium",
    "subagentSearchEffort": "low",
    "highEffortMaxContextTokens": 40000,
    "enforceCleanSubagentForHighEffort": true
  },
  "extensions": {
    "enabledPacks": [
      "extensions/evidence-driven-engineering",
      "extensions/agent-handoff-governance"
    ]
  },
  "delivery": {
    "source": {
      "kind": "github",
      "repo": "smota/agentflow-sdlc",
      "branch": "agentflow-state"
    },
    "candidate": {
      "inputs": [
        "adapters/openrig/README.md",
        "adapters/openrig/__tests__/execution-plan.test.mjs",
        "adapters/openrig/__tests__/execution-route-roundtrip.test.mjs",
        "adapters/openrig/agentflow-product/configurations.yaml",
        "adapters/openrig/agentflow-steer/configurations.yaml",
        "adapters/openrig/agentflow/configurations.yaml",
        "adapters/openrig/execution-plan.mjs",
        "adapters/openrig/lifecycle.mjs",
        "adapters/openrig/manifest.json",
        "adapters/openrig/platform-fallback.mjs",
        "agent-workflow.config.json",
        "docs/operators/index.md",
        "docs/operators/openrig-execution-contracts.md",
        "lib/__tests__/execution-contract-review.test.mjs",
        "lib/__tests__/execution-contract.test.mjs",
        "lib/__tests__/execution-policy-projection.test.mjs",
        "lib/__tests__/openrig-platform-fallback.test.mjs",
        "lib/adapters/lifecycle.mjs",
        "lib/config/authority.mjs",
        "lib/config/execution-contract.mjs",
        "lib/config/execution-defaults.mjs",
        "lib/config/harness-defaults.mjs",
        "lib/config/harness-intelligence.mjs",
        "lib/config/projection.mjs",
        "package.json",
        "pnpm-lock.yaml",
        "schemas/agentflow-config.schema.json",
        "scripts/__tests__/adapter-lifecycle.test.mjs",
        "scripts/__tests__/execution-plan-cli.test.mjs"
      ],
      "context": {
        "workstream": "goal-516",
        "scope": "Issue 517 execution contracts; refresh before the next candidate"
      }
    },
    "checks": {
      "docs": {
        "id": "docs",
        "criterionId": "documentation-integrity",
        "executable": "node",
        "args": ["scripts/validate-docs.mjs"],
        "assertions": ["documentation validation passes"],
        "format": "exit-code",
        "timeoutMs": 60000
      },
      "onboarding": {
        "id": "onboarding",
        "criterionId": "onboarding-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/onboarding-runtime.test.mjs",
          "lib/__tests__/onboarding-template.test.mjs",
          "lib/__tests__/onboarding-inventory.test.mjs",
          "lib/__tests__/onboarding-plan.test.mjs",
          "lib/__tests__/onboarding-apply.test.mjs",
          "lib/__tests__/onboarding-migration.test.mjs",
          "lib/__tests__/onboarding-e2e.test.mjs"
        ],
        "assertions": ["incremental onboarding regression suite passes"],
        "format": "exit-code",
        "timeoutMs": 120000
      },
      "autonomy": {
        "id": "autonomy",
        "criterionId": "autonomy-regression",
        "executable": "node",
        "args": ["node_modules/vitest/vitest.mjs", "run"],
        "assertions": ["complete regression suite passes"],
        "format": "exit-code",
        "timeoutMs": 180000,
        "inheritEnv": ["TEMP", "TMP", "HOME", "USERPROFILE"]
      },
      "openrig-execution-contract": {
        "id": "openrig-execution-contract",
        "criterionId": "execution-contract-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/execution-contract.test.mjs",
          "lib/__tests__/execution-contract-review.test.mjs",
          "lib/__tests__/execution-policy-projection.test.mjs",
          "lib/__tests__/config-authority.test.mjs",
          "lib/__tests__/config-projection.test.mjs",
          "lib/__tests__/config-suite.test.mjs",
          "lib/__tests__/openrig-platform-fallback.test.mjs",
          "adapters/openrig/__tests__/execution-plan.test.mjs",
          "adapters/openrig/__tests__/execution-route-roundtrip.test.mjs",
          "scripts/__tests__/execution-plan-cli.test.mjs",
          "scripts/__tests__/adapter-lifecycle.test.mjs"
        ],
        "assertions": ["execution-contract-regressions-pass"],
        "format": "exit-code",
        "timeoutMs": 120000,
        "inheritEnv": ["HOME", "USERPROFILE"]
      }
    },
    "contracts": {
      "product-manager": ".agent-runs/completion/acceptance.json"
    },
    "delegation": {
      "issuerId": "local",
      "reviewCheck": "documentation-integrity",
      "policy": {
        "version": 1,
        "issuers": [
          {
            "id": "local",
            "mode": "local-cooperative",
            "origin": "cli",
            "authorityRef": "user:authorized-autonomy-completion",
            "allowedActions": ["pr:create", "pr:update"],
            "allowThroughMerge": false
          }
        ],
        "requiredChecks": ["autonomy-regression"],
        "reviewPolicy": "automated",
        "materiality": "fixed-scope-v1",
        "allowSubdelegation": false,
        "safetyReserve": 4
      }
    }
  }
}
