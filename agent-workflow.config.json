{
  "ciCommands": ["pnpm test", "pnpm test:workflow", "pnpm format:check"],
  "bounded": {
    "allowedExactPaths": ["README.md", "AGENTS.md", "CLAUDE.md", "CODEX.md", "AGY.md"],
    "allowedPathPrefixes": ["docs/", "agents/templates/", "agents/workflows/"],
    "deniedPathFragments": ["/auth/", "/billing/", "/migrations/"],
    "defaultBase": "origin/development"
  },
  "branching": {
    "trunk": "main",
    "releaseCandidate": null,
    "integration": "development",
    "directEditDeniedBranches": ["main", "development"],
    "defaultPrTarget": "development",
    "promotionOrder": ["development", "main"],
    "workBranchPrefixes": ["work/", "feature/", "fix/", "hotfix/", "spike/", "chore/"],
    "compatibilityBranchPrefixes": ["issue/", "wt/", "claude/"],
    "requireBoundedWorkBranch": true
  },
  "integrationLifecycle": {
    "integrationBranch": "development",
    "trunkBranch": "main",
    "referenceKeywords": ["Implements", "Closes"],
    "addLabels": ["integrated:development", "awaiting-release"],
    "closeIntegratedIssues": true
  },
  "routing": {
    "defaultMode": "optional-multi-agent",
    "agents": {
      "grok": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "grok",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "grok-cli",
        "callWorkflowDoc": "docs/agents/grok-routing.md"
      },
      "claude": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "claude",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "claude-cli",
        "callWorkflowDoc": "docs/agents/claude-routing.md"
      },
      "codex": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "codex",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "codex-cli",
        "callWorkflowDoc": "docs/agents/codex-routing.md"
      },
      "agy": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "agy",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "agy-cli",
        "callWorkflowDoc": "docs/agents/agy-routing.md"
      }
    },
    "roles": {
      "product-manager": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "analyst": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "architect": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "implementation-planner": {
        "owner": "grok",
        "fallbacks": ["claude", "codex"]
      },
      "developer": {
        "owner": "claude",
        "fallbacks": ["grok", "codex"]
      },
      "tester": {
        "owner": "codex",
        "fallbacks": ["claude", "grok"]
      },
      "reviewer": {
        "owner": "grok",
        "fallbacks": ["codex", "claude"]
      },
      "technical-writer": {
        "owner": "claude",
        "fallbacks": ["grok", "codex"]
      },
      "pr-readiness": {
        "owner": "grok",
        "fallbacks": ["codex", "claude"]
      }
    }
  },
  "collaboration": {
    "defaultMode": "auto-minimal",
    "sensitiveSurfaces": ["security", "auth", "data", "infra", "billing"],
    "councilDomainThreshold": 3,
    "bilateralDomainThreshold": 2,
    "councilOnPublicContract": true,
    "councilOnMigration": true,
    "councilHelpers": [
      "risk-scout",
      "implementation-strategist",
      "testability-scout",
      "docs-impact-scout"
    ],
    "discoveryHelpers": ["requirements-scout", "architecture-scout"],
    "councilSeats": [
      {
        "role": "agentflow:architect",
        "focus": "architecture and system boundaries",
        "required": true
      },
      {
        "role": "agentflow:developer",
        "focus": "implementation feasibility",
        "required": true
      },
      {
        "role": "agentflow:tester",
        "focus": "testability and failure evidence",
        "required": true
      },
      {
        "role": "agentflow:reviewer",
        "focus": "risk and maintainability",
        "required": true
      }
    ],
    "fallbackModes": ["sequential", "manual"],
    "maxDelegates": 4,
    "maxDepth": 1,
    "maxIterations": 3
  },
  "extensions": {
    "enabledPacks": [
      "extensions/evidence-driven-engineering",
      "extensions/agent-handoff-governance"
    ]
  },
  "delivery": {
    "source": {
      "kind": "github",
      "repo": "smota/agentflow-sdlc",
      "branch": "agentflow-state"
    },
    "candidate": {
      "inputs": [
        ".agentflow/model-catalog.json",
        "AGENTS.md",
        "CODEX.md",
        "agent-workflow.config.json",
        "bin/cli.mjs",
        "defaults/sdlc.config.json",
        "docs/adr/index.md",
        "docs/agent-workflow.md",
        "docs/guiding-principles.md",
        "docs/issue-standards.md",
        "docs/maintainers/process-autonomy-completion.md",
        "docs/maintainers/process-autonomy-reconciliation.md",
        "docs/process-autonomy/adoption-matrix.md",
        "docs/process-autonomy/harness-dispatch.md",
        "docs/process-autonomy/meshloop-review.md",
        "docs/run-operations.md",
        "lib/__tests__/codex-engineering.test.mjs",
        "lib/__tests__/context-service.test.mjs",
        "lib/__tests__/delegation-source-races.test.mjs",
        "lib/__tests__/engineering-evidence.test.mjs",
        "lib/__tests__/engineering-neutral-conformance.test.mjs",
        "lib/__tests__/github-delivery-actions.test.mjs",
        "lib/__tests__/handover-protocol.test.mjs",
        "lib/__tests__/harness-execution-contract.test.mjs",
        "lib/__tests__/journal-process-recovery.test.mjs",
        "lib/__tests__/journaled-run-store.test.mjs",
        "lib/__tests__/onboarding-retrospective.test.mjs",
        "lib/__tests__/portable-continuation.test.mjs",
        "lib/__tests__/process-analysis-dimensions.test.mjs",
        "lib/__tests__/run-service.test.mjs",
        "lib/__tests__/run-store-migration.test.mjs",
        "lib/__tests__/telemetry-boundary-review.test.mjs",
        "lib/application/context-service.mjs",
        "lib/application/continuation-service.mjs",
        "lib/application/run-service.mjs",
        "lib/core/run-state.mjs",
        "lib/observability/analysis.mjs",
        "lib/observability/events.mjs",
        "lib/providers/codex-engineering.mjs",
        "lib/providers/engineering-evidence.mjs",
        "lib/providers/github-delivery-actions.mjs",
        "lib/providers/governed-engineering.mjs",
        "lib/providers/harness-dispatch.mjs",
        "lib/providers/local-cli.mjs",
        "lib/providers/registry.mjs",
        "lib/runtime/context-sanitizer.mjs",
        "lib/runtime/handover-protocol.mjs",
        "lib/sources/github-api-cli.mjs",
        "lib/sources/journaled-run-store.mjs",
        "lib/sources/pending-audit-journal.mjs",
        "lib/sources/segmented-run-store.mjs",
        "package.json",
        "pnpm-lock.yaml",
        "schemas/delivery-config.schema.json",
        "schemas/engineering-capability.schema.json",
        "schemas/engineering-lifecycle.schema.json",
        "schemas/engineering-request.schema.json",
        "schemas/engineering-result.schema.json",
        "scripts/__tests__/delegation-journey.test.mjs",
        "scripts/__tests__/run-delivery-delegation.test.mjs",
        "scripts/__tests__/run-delivery-replay-exit.test.mjs",
        "scripts/benchmark-process-telemetry.mjs",
        "scripts/benchmark-run-telemetry.mjs",
        "scripts/benchmark-segmented-run-store.mjs",
        "scripts/run-delivery.mjs"
      ],
      "context": {
        "workstream": "autonomy-completion",
        "scope": "explicit changed files and repository policy; refresh before a new workstream"
      }
    },
    "checks": {
      "docs": {
        "id": "docs",
        "criterionId": "documentation-integrity",
        "executable": "node",
        "args": ["scripts/validate-docs.mjs"],
        "assertions": ["documentation validation passes"],
        "format": "exit-code",
        "timeoutMs": 60000
      },
      "onboarding": {
        "id": "onboarding",
        "criterionId": "onboarding-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/onboarding-runtime.test.mjs",
          "lib/__tests__/onboarding-template.test.mjs",
          "lib/__tests__/onboarding-inventory.test.mjs",
          "lib/__tests__/onboarding-plan.test.mjs",
          "lib/__tests__/onboarding-apply.test.mjs",
          "lib/__tests__/onboarding-migration.test.mjs",
          "lib/__tests__/onboarding-e2e.test.mjs"
        ],
        "assertions": ["incremental onboarding regression suite passes"],
        "format": "exit-code",
        "timeoutMs": 120000
      },
      "autonomy": {
        "id": "autonomy",
        "criterionId": "autonomy-regression",
        "executable": "node",
        "args": ["node_modules/vitest/vitest.mjs", "run"],
        "assertions": ["complete regression suite passes"],
        "format": "exit-code",
        "timeoutMs": 180000,
        "inheritEnv": ["TEMP", "TMP", "HOME", "USERPROFILE"]
      }
    },
    "contracts": {
      "product-manager": ".agent-runs/completion/acceptance.json"
    },
    "delegation": {
      "issuerId": "local",
      "reviewCheck": "documentation-integrity",
      "policy": {
        "version": 1,
        "issuers": [
          {
            "id": "local",
            "mode": "local-cooperative",
            "origin": "cli",
            "authorityRef": "user:authorized-autonomy-completion",
            "allowedActions": ["pr:create", "pr:update"],
            "allowThroughMerge": false
          }
        ],
        "requiredChecks": ["autonomy-regression"],
        "reviewPolicy": "automated",
        "materiality": "fixed-scope-v1",
        "allowSubdelegation": false,
        "safetyReserve": 4
      }
    }
  }
}
