{
  "ciCommands": ["pnpm test", "pnpm test:workflow", "pnpm format:check"],
  "bounded": {
    "allowedExactPaths": ["README.md", "AGENTS.md", "CLAUDE.md", "CODEX.md", "AGY.md"],
    "allowedPathPrefixes": ["docs/", "agents/templates/", "agents/workflows/"],
    "deniedPathFragments": ["/auth/", "/billing/", "/migrations/"],
    "defaultBase": "origin/development"
  },
  "branching": {
    "trunk": "main",
    "releaseCandidate": null,
    "integration": "development",
    "directEditDeniedBranches": ["main", "development"],
    "defaultPrTarget": "development",
    "promotionOrder": ["development", "main"],
    "workBranchPrefixes": ["work/", "feature/", "fix/", "hotfix/", "spike/", "chore/"],
    "compatibilityBranchPrefixes": ["issue/", "wt/", "claude/"],
    "requireBoundedWorkBranch": true
  },
  "integrationLifecycle": {
    "integrationBranch": "development",
    "trunkBranch": "main",
    "referenceKeywords": ["Implements", "Closes"],
    "addLabels": ["integrated:development", "awaiting-release"],
    "closeIntegratedIssues": true
  },
  "routing": {
    "defaultMode": "optional-multi-agent",
    "agents": {
      "grok": {
        "enabled": false,
        "availabilityProbe": {
          "executable": "grok",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "grok-cli",
        "callWorkflowDoc": "docs/agents/grok-routing.md"
      },
      "claude": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "claude",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "claude-cli",
        "callWorkflowDoc": "docs/agents/claude-routing.md"
      },
      "codex": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "codex",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "codex-cli",
        "callWorkflowDoc": "docs/agents/codex-routing.md"
      },
      "agy": {
        "enabled": true,
        "availabilityProbe": {
          "executable": "agy",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "agy-cli",
        "callWorkflowDoc": "docs/agents/agy-routing.md"
      },
      "pi": {
        "enabled": false,
        "availabilityProbe": {
          "executable": "pi",
          "args": ["--version"]
        },
        "defaultExecutionTarget": "pi-parent",
        "callWorkflowDoc": "docs/agents/pi-routing.md"
      }
    },
    "roles": {
      "product-manager": {
        "owner": "codex",
        "fallbacks": ["claude"]
      },
      "analyst": {
        "owner": "codex",
        "fallbacks": ["claude"]
      },
      "architect": {
        "owner": "codex",
        "fallbacks": ["claude"]
      },
      "implementation-planner": {
        "owner": "codex",
        "fallbacks": ["claude"]
      },
      "developer": {
        "owner": "codex",
        "fallbacks": ["claude"]
      },
      "tester": {
        "owner": "codex",
        "fallbacks": ["claude"]
      },
      "reviewer": {
        "owner": "claude",
        "fallbacks": ["codex"]
      },
      "technical-writer": {
        "owner": "claude",
        "fallbacks": ["codex"]
      },
      "pr-readiness": {
        "owner": "codex",
        "fallbacks": ["claude"]
      }
    }
  },
  "collaboration": {
    "defaultMode": "auto-minimal",
    "sensitiveSurfaces": ["security", "auth", "data", "infra", "billing"],
    "councilDomainThreshold": 3,
    "bilateralDomainThreshold": 2,
    "councilOnPublicContract": true,
    "councilOnMigration": true,
    "maxReworkRounds": 2,
    "councilHelpers": [
      "risk-scout",
      "implementation-strategist",
      "testability-scout",
      "docs-impact-scout"
    ],
    "discoveryHelpers": ["requirements-scout", "architecture-scout"],
    "councilSeats": [
      {
        "role": "agentflow:architect",
        "focus": "architecture and system boundaries",
        "required": true
      },
      {
        "role": "agentflow:developer",
        "focus": "implementation feasibility",
        "required": true
      },
      {
        "role": "agentflow:tester",
        "focus": "testability and failure evidence",
        "required": true
      },
      {
        "role": "agentflow:reviewer",
        "focus": "risk and maintainability",
        "required": true
      }
    ],
    "fallbackModes": ["sequential", "manual"],
    "maxDelegates": 4,
    "maxDepth": 1,
    "maxIterations": 3
  },
  "executionTopology": {
    "substrateTier": "auto",
    "openrigSquadPreset": "lean-4-seat",
    "compositeBuilderMaxRung": "P1"
  },
  "effortPolicy": {
    "defaultLoopEffort": "medium",
    "subagentSearchEffort": "low",
    "highEffortMaxContextTokens": 40000,
    "enforceCleanSubagentForHighEffort": true
  },
  "extensions": {
    "enabledPacks": [
      "extensions/evidence-driven-engineering",
      "extensions/agent-handoff-governance"
    ]
  },
  "delivery": {
    "source": {
      "kind": "github",
      "repo": "smota/agentflow-sdlc",
      "branch": "agentflow-state"
    },
    "candidate": {
      "inputs": [
        "adapters/openrig/README.md",
        "adapters/openrig/__tests__/execution-plan.test.mjs",
        "adapters/openrig/__tests__/execution-route-roundtrip.test.mjs",
        "adapters/openrig/__tests__/fixtures/pi-runner-observation-candidate-v1.json",
        "adapters/openrig/__tests__/mutation-proof.test.mjs",
        "adapters/openrig/__tests__/mutation-review.test.mjs",
        "adapters/openrig/__tests__/mutation.test.mjs",
        "adapters/openrig/__tests__/operational-preflight-review.test.mjs",
        "adapters/openrig/__tests__/operational-preflight.test.mjs",
        "adapters/openrig/__tests__/recovery.test.mjs",
        "adapters/openrig/__tests__/runtime-capabilities.test.mjs",
        "adapters/openrig/agentflow-product/README.md",
        "adapters/openrig/agentflow-product/configurations.yaml",
        "adapters/openrig/agentflow-product/handoff-step.mjs",
        "adapters/openrig/agentflow-product/handoff.mjs",
        "adapters/openrig/agentflow-product/oracle-admission.mjs",
        "adapters/openrig/agentflow-product/pipeline-admission.mjs",
        "adapters/openrig/agentflow-steer/CULTURE.md",
        "adapters/openrig/agentflow-steer/configurations.yaml",
        "adapters/openrig/agentflow/agents/agentflow/agent.yaml",
        "adapters/openrig/agentflow/agents/agentflow/guidance/test-eng.md",
        "adapters/openrig/agentflow/configurations.yaml",
        "adapters/openrig/execution-plan.mjs",
        "adapters/openrig/lifecycle.mjs",
        "adapters/openrig/manifest.json",
        "adapters/openrig/mutation.mjs",
        "adapters/openrig/operational-preflight.mjs",
        "adapters/openrig/platform-fallback.mjs",
        "adapters/openrig/recovery.mjs",
        "adapters/openrig/runtime-capabilities.mjs",
        "agent-workflow.config.json",
        "docs/evidence-contracts.md",
        "docs/openrig-recovery.md",
        "docs/openrig-runtime-compatibility.md",
        "docs/operators/index.md",
        "docs/operators/openrig-execution-contracts.md",
        "docs/operators/openrig-mutations.md",
        "docs/process-autonomy/delegation.md",
        "docs/steering-merge-authority.md",
        "lib/__tests__/configured-run-source.test.mjs",
        "lib/__tests__/execution-contract-review.test.mjs",
        "lib/__tests__/execution-contract.test.mjs",
        "lib/__tests__/execution-policy-projection.test.mjs",
        "lib/__tests__/fallback-health.test.mjs",
        "lib/__tests__/handoff-custody.test.mjs",
        "lib/__tests__/openrig-handoff-pipeline.test.mjs",
        "lib/__tests__/openrig-platform-fallback.test.mjs",
        "lib/__tests__/oracle-custody.test.mjs",
        "lib/__tests__/oracle-writer-admission.test.mjs",
        "lib/__tests__/oracle-writer-scope-regression.test.mjs",
        "lib/__tests__/rig-mutation-action.test.mjs",
        "lib/__tests__/steering-binding.test.mjs",
        "lib/__tests__/steering-merge-policy.test.mjs",
        "lib/adapters/lifecycle.mjs",
        "lib/application/configured-run-source.mjs",
        "lib/application/run-service.mjs",
        "lib/config/authority.mjs",
        "lib/config/execution-contract.mjs",
        "lib/config/execution-defaults.mjs",
        "lib/config/harness-defaults.mjs",
        "lib/config/harness-intelligence.mjs",
        "lib/config/projection.mjs",
        "lib/core/delegation-grant.mjs",
        "lib/core/execution-receipt.mjs",
        "lib/core/model-family.mjs",
        "lib/core/oracle-custody.mjs",
        "lib/core/run-state.mjs",
        "lib/core/steering-binding.mjs",
        "lib/core/steering-merge-policy.mjs",
        "lib/evidence-contracts.mjs",
        "package.json",
        "pnpm-lock.yaml",
        "schemas/agentflow-config.schema.json",
        "schemas/delegation-grant.schema.json",
        "schemas/oracle-custody.schema.json",
        "schemas/run-event.schema.json",
        "scripts/__tests__/adapter-lifecycle.test.mjs",
        "scripts/__tests__/execution-plan-cli.test.mjs",
        "scripts/__tests__/handoff-hold.test.mjs",
        "scripts/__tests__/operational-preflight-cli.test.mjs",
        "scripts/__tests__/steer.test.mjs",
        "scripts/__tests__/steering-authority-review.test.mjs",
        "scripts/__tests__/steering-authority.test.mjs",
        "scripts/__tests__/steering-merge-authority.test.mjs",
        "scripts/run-delivery.mjs",
        "scripts/steer.mjs",
        "scripts/validate-evidence-contract.mjs"
      ],
      "context": {
        "workstream": "goal-516",
        "scope": "Steering publication checkpoint; high-assurance review pending"
      }
    },
    "checks": {
      "docs": {
        "id": "docs",
        "criterionId": "documentation-integrity",
        "executable": "node",
        "args": ["scripts/validate-docs.mjs"],
        "assertions": ["documentation validation passes"],
        "format": "exit-code",
        "timeoutMs": 60000
      },
      "onboarding": {
        "id": "onboarding",
        "criterionId": "onboarding-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/onboarding-runtime.test.mjs",
          "lib/__tests__/onboarding-template.test.mjs",
          "lib/__tests__/onboarding-inventory.test.mjs",
          "lib/__tests__/onboarding-plan.test.mjs",
          "lib/__tests__/onboarding-apply.test.mjs",
          "lib/__tests__/onboarding-migration.test.mjs",
          "lib/__tests__/onboarding-e2e.test.mjs"
        ],
        "assertions": ["incremental onboarding regression suite passes"],
        "format": "exit-code",
        "timeoutMs": 120000
      },
      "autonomy": {
        "id": "autonomy",
        "criterionId": "autonomy-regression",
        "executable": "node",
        "args": ["node_modules/vitest/vitest.mjs", "run"],
        "assertions": ["complete regression suite passes"],
        "format": "exit-code",
        "timeoutMs": 180000,
        "inheritEnv": ["TEMP", "TMP", "HOME", "USERPROFILE"]
      },
      "openrig-execution-contract": {
        "id": "openrig-execution-contract",
        "criterionId": "execution-contract-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/execution-contract.test.mjs",
          "lib/__tests__/execution-contract-review.test.mjs",
          "lib/__tests__/execution-policy-projection.test.mjs",
          "lib/__tests__/config-authority.test.mjs",
          "lib/__tests__/config-projection.test.mjs",
          "lib/__tests__/config-suite.test.mjs",
          "lib/__tests__/openrig-platform-fallback.test.mjs",
          "adapters/openrig/__tests__/execution-plan.test.mjs",
          "adapters/openrig/__tests__/execution-route-roundtrip.test.mjs",
          "scripts/__tests__/execution-plan-cli.test.mjs",
          "scripts/__tests__/adapter-lifecycle.test.mjs"
        ],
        "assertions": ["execution-contract-regressions-pass"],
        "format": "exit-code",
        "timeoutMs": 120000,
        "inheritEnv": ["HOME", "USERPROFILE"]
      },
      "openrig-preflight": {
        "id": "openrig-preflight",
        "criterionId": "operational-preflight-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "adapters/openrig/__tests__/operational-preflight.test.mjs",
          "adapters/openrig/__tests__/operational-preflight-review.test.mjs",
          "scripts/__tests__/operational-preflight-cli.test.mjs",
          "scripts/__tests__/adapter-lifecycle.test.mjs"
        ],
        "assertions": ["operational-preflight-regressions-pass"],
        "format": "exit-code",
        "timeoutMs": 120000,
        "inheritEnv": ["HOME", "USERPROFILE"]
      },
      "steering-authority": {
        "id": "steering-authority",
        "criterionId": "steering-authority-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/steering-binding.test.mjs",
          "scripts/__tests__/steering-authority.test.mjs",
          "scripts/__tests__/steering-authority-review.test.mjs",
          "scripts/__tests__/steer.test.mjs"
        ],
        "assertions": ["steering-authority-regressions-pass"],
        "format": "exit-code",
        "timeoutMs": 120000,
        "inheritEnv": ["HOME", "USERPROFILE"]
      },
      "steering-publication": {
        "id": "steering-publication",
        "criterionId": "steering-publication-regression",
        "executable": "node",
        "args": [
          "node_modules/vitest/vitest.mjs",
          "run",
          "lib/__tests__/steering-merge-policy.test.mjs",
          "scripts/__tests__/steering-merge-authority.test.mjs",
          "scripts/__tests__/steer.test.mjs",
          "lib/__tests__/steering-binding.test.mjs",
          "scripts/__tests__/steering-authority.test.mjs",
          "scripts/__tests__/steering-authority-review.test.mjs"
        ],
        "assertions": ["steering-publication-regressions-pass"],
        "format": "exit-code",
        "timeoutMs": 120000,
        "inheritEnv": ["HOME", "USERPROFILE"]
      }
    },
    "contracts": {
      "product-manager": ".agent-runs/completion/acceptance.json"
    },
    "delegation": {
      "issuerId": "local",
      "reviewCheck": "documentation-integrity",
      "policy": {
        "version": 1,
        "issuers": [
          {
            "id": "local",
            "mode": "local-cooperative",
            "origin": "cli",
            "authorityRef": "user:authorized-autonomy-completion",
            "allowedActions": ["pr:create", "pr:update"],
            "allowThroughMerge": false
          }
        ],
        "requiredChecks": ["autonomy-regression"],
        "reviewPolicy": "automated",
        "materiality": "fixed-scope-v1",
        "allowSubdelegation": false,
        "safetyReserve": 4
      }
    }
  },
  "adapters": {
    "openrig": {
      "executionPolicy": {
        "preset": "all-codex",
        "seats": {
          "orch.arch": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "architect"
          },
          "dev.build": {
            "runtime": "pi",
            "providerRoute": "munito",
            "model": "qwen/qwen3.8-27b",
            "effort": "medium",
            "profile": "builder-pi"
          },
          "dev.qa": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "low",
            "profile": "qa"
          },
          "rev.review": {
            "runtime": "claude-code",
            "providerRoute": "anthropic",
            "model": "claude-sonnet-5-5",
            "effort": "medium",
            "profile": "reviewer"
          },
          "eval.tester": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "low",
            "profile": "eval-tester"
          },
          "pm.manager": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "product-manager"
          },
          "pm.analyst": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "analyst"
          },
          "steer.lead": {
            "runtime": "codex",
            "providerRoute": "openai-codex",
            "model": "gpt-6.1-sol",
            "effort": "medium",
            "profile": "steering-lead"
          }
        },
        "activation": "held"
      }
    }
  }
}
